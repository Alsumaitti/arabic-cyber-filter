# ---------------------------------------------------------------------------
# Large data artifacts are NOT tracked in git (multi-GB / >100 MB GitHub limit).
# See README.md ("Data availability") for how to obtain or regenerate them.
# ---------------------------------------------------------------------------

# Source corpus shards (FineWeb2 sample, ~1.7 GB)
FineWeb2/

# Per-shard filtered outputs produced by the SLURM array job (~365 MB)
output/

# v2 re-filter (expanded 1,233-keyword lexicon) — same size class as v1
output_v2/
# Merged corpora exceed GitHub's 100 MB per-file limit — regenerate via merge job
result/

# In-chat judging working set: chunks are regenerated by prepare_chat_judging.py;
# the merged judged corpus is large. Judgment files themselves ARE tracked.
evaluation/chat_judging/chunks/
evaluation/chat_judging/judged_corpus.json

# SLURM job logs
logs/

# Local tooling / environment
.claude/
__pycache__/
*.pyc
.venv/
venv/

# OS noise
Thumbs.db
.DS_Store

# Evaluation scratch (judge-view text batches; regenerated from sample_matched.json)
evaluation/batches/

# Keyword-mining scratch (pool texts; regenerated by collect_pool_texts.py)
evaluation/scratch/

# v3/v4 per-shard filter outputs (regenerable, GBs)
output_v4/
output_tiered/
