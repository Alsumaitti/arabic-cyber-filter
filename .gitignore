output/

# SLURM job logs
logs/

# Local tooling / environment
.claude/
__pycache__/
*.pyc
.venv/
venv/

# OS noise
Thumbs.db
.DS_Store

# Evaluation scratch (judge-view text batches; regenerated from sample_matched.json)
evaluation/batches/

# Keyword-mining scratch (pool texts; regenerated by collect_pool_texts.py)
evaluation/scratch/
